---
---

@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap");

// Colour palette: oat, warm brown, forest green
$brand-color: #344B38;

$base-font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
$base-font-size: 17px;
$base-line-height: 1.8;

$text-color: #3D3932;
$background-color: #F4F0E6;

$grey-color: #898274;
$grey-color-light: #DED7C9;
$grey-color-dark: #5B554A;

$content-width: 780px;

@import "minima";

// Typography
h1, h2, h3, h4,
.site-title, .post-title, .post-link {
  font-family: "Lora", Georgia, serif;
  font-weight: 500;
  letter-spacing: -0.02em;
}

// Links
a {
  color: $brand-color;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;

  &:hover {
    color: #6B7654;
    text-decoration-thickness: 2px;
  }
}

// Header
.site-header {
  border-top: 3px solid $brand-color;
  border-bottom: 1px solid $grey-color-light;
}

.site-title,
.site-title:visited {
  color: $brand-color;
  font-size: 1.65rem;
  font-weight: 600;
}

.site-nav .page-link {
  color: $grey-color-dark;
  font-weight: 500;

  &:hover {
    color: $brand-color;
  }
}

.site-title,
.site-nav .page-link,
.post-link {
  text-decoration: none;
}

// Homepage
.post-list-heading {
  font-family: "DM Sans", sans-serif;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: $grey-color;
}

.post-list > li {
  margin-bottom: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid $grey-color-light;

  &:last-child {
    border-bottom: none;
  }
}

.post-link {
  font-size: 1.7rem;
  line-height: 1.4;
}

.post-meta {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: $grey-color;
}

// Article pages
.post-title {
  font-size: 2.4rem;
  line-height: 1.3;
}

.post-content h2 {
  font-size: 1.65rem;
  margin-top: 2.5rem;
  color: $brand-color;
}

.post-content p {
  margin-bottom: 1.4rem;
}

// Quotes
blockquote {
  border-left: 3px solid #A18B68;
  color: $grey-color-dark;
  font-family: "Lora", Georgia, serif;
  font-style: italic;
  padding-left: 1rem;
}

// Footer
.site-footer {
  border-top: 1px solid $grey-color-light;
  margin-top: 3rem;
}
